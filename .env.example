# Configuration LLM QUANTA — copier vers .env et renseigner les clés (jamais commit)
PRIMARY_API_KEY=your_groq_key_here
PRIMARY_BASE_URL=https://api.groq.com/openai/v1
PRIMARY_MODEL=llama-3.3-70b-versatile
FALLBACK_API_KEY=your_openrouter_key_here
FALLBACK_BASE_URL=https://openrouter.ai/api/v1
FALLBACK_MODEL=deepseek/deepseek-chat
# Ajouter le domaine de production séparé par des virgules, ex: https://votre-domaine.com,http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000
QUANTA_DB_PATH=/data/quanta.db
QUANTA_UPLOAD_DIR=/data/uploads
